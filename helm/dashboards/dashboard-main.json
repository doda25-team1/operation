                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Requests by Status Code",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
            },
            "description": "Requests per minute - Alert threshold is at 15 req/min",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "mappings": [],
                    "max": 30,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 15
                            }
                        ]
                    },
                    "unit": "reqpm"
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 16
            },
            "id": 8,
            "options": {
                "minVizHeight": 75,
                "minVizWidth": 75,
                "orientation": "auto",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                },
                "showThresholdLabels": true,
                "showThresholdMarkers": true,
                "sizing": "auto"
            },
            "pluginVersion": "10.2.0",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "${datasource}"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(app_http_requests_total[1m])) * 60",
                    "legendFormat": "Req/min",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Request Rate (Alerting Threshold)",
            "type": "gauge"
        }
